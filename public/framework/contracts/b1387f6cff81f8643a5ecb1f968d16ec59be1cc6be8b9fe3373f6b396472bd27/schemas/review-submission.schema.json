{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotorbench.example/schemas/review-submission.schema.json",
  "title": "Identity-neutral reviewer input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "role",
    "attestations",
    "gateRatings",
    "expertRatings"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "role": { "enum": ["primary", "secondary", "adjudicator"] },
    "attestations": { "$ref": "#/$defs/attestations" },
    "gateRatings": {
      "type": "array",
      "items": { "$ref": "#/$defs/gateRating" }
    },
    "expertRatings": {
      "type": "array",
      "items": { "$ref": "#/$defs/rating" }
    }
  },
  "$defs": {
    "attestations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independentFromCandidate",
        "independentFromOtherReviewers",
        "blindToCandidateIdentity",
        "reviewedSanitizedEvidenceOnly",
        "ratingLockedBeforeAdjudication"
      ],
      "properties": {
        "independentFromCandidate": { "const": true },
        "independentFromOtherReviewers": { "const": true },
        "blindToCandidateIdentity": { "const": true },
        "reviewedSanitizedEvidenceOnly": { "const": true },
        "ratingLockedBeforeAdjudication": { "const": true }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^EVD-[0-9]{3,}$" }
    },
    "gateRating": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateId", "result", "evidenceRefs", "rationale"],
      "properties": {
        "gateId": { "enum": ["B0", "B1", "B2", "B3", "B4", "B5", "B6"] },
        "result": { "enum": ["pass", "fail", "not-evaluable", "evaluator-unsupported", "evaluator-uncertain"] },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensionId", "status", "evidenceRefs", "rationale"],
      "properties": {
        "dimensionId": { "type": "string", "pattern": "^D(?:0[1-9]|10)$" },
        "status": { "enum": ["scored", "not-evaluable", "evaluator-unsupported", "evaluator-uncertain"] },
        "score": { "type": "integer", "minimum": 0, "maximum": 4 },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "scored" } }, "required": ["status"] },
          "then": { "properties": { "score": true }, "required": ["score"] },
          "else": { "not": { "required": ["score"] } }
        }
      ]
    }
  }
}
