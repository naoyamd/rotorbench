{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotorbench.example/schemas/submission.schema.json",
  "title": "Candidate engineering submission bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolVersion",
    "status",
    "launchId",
    "taskPacket",
    "fairnessFingerprint",
    "model",
    "initialPlan",
    "initialPlanCheckpoint",
    "workRecord",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "protocolVersion": { "enum": ["2.0", "3.0", "4.0"] },
    "status": { "enum": ["complete", "partial"] },
    "launchId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "taskPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "artifact.schema.json#/$defs/sha256" },
        "bundleDigest": { "$ref": "artifact.schema.json#/$defs/sha256" }
      }
    },
    "executionContractDigest": { "$ref": "artifact.schema.json#/$defs/sha256" },
    "promptSha256": { "$ref": "artifact.schema.json#/$defs/sha256" },
    "launchDigest": { "$ref": "artifact.schema.json#/$defs/sha256" },
    "fairnessFingerprint": { "$ref": "artifact.schema.json#/$defs/sha256" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "version"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "initialPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "plan.json" },
        "sha256": { "$ref": "artifact.schema.json#/$defs/sha256" }
      }
    },
    "initialPlanCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "initial-plan.sha256" },
        "sha256": { "$ref": "artifact.schema.json#/$defs/sha256" }
      }
    },
    "workRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "work-record.json" },
        "sha256": { "$ref": "artifact.schema.json#/$defs/sha256" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "artifact.schema.json" }
    },
    "checkpointReceipts": {
      "type": "array",
      "items": { "$ref": "stage-contract-v4.schema.json#/$defs/checkpointReceipt" }
    },
    "partialAttainment": { "$ref": "stage-contract-v4.schema.json#/$defs/partialAttainment" },
    "sanitizationRequest": { "$ref": "stage-contract-v4.schema.json#/$defs/sanitizationRequest" },
    "v4Contract": { "$ref": "stage-contract-v4.schema.json#/$defs/v4Contract" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "protocolVersion": { "const": "2.0" } },
        "required": ["protocolVersion"]
      },
      "then": { "properties": { "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "artifact.schema.json" } } } }
    },
    {
      "if": {
        "properties": { "protocolVersion": { "const": "3.0" } },
        "required": ["protocolVersion"]
      },
      "then": {
        "required": ["executionContractDigest", "promptSha256", "launchDigest"],
        "properties": {
          "executionContractDigest": true,
          "promptSha256": true,
          "launchDigest": true,
          "taskPacket": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "digest", "bundleDigest"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "version": { "type": "string", "minLength": 1 },
              "digest": { "$ref": "artifact.schema.json#/$defs/sha256" },
              "bundleDigest": { "$ref": "artifact.schema.json#/$defs/sha256" }
            }
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "allOf": [
                { "$ref": "artifact.schema.json" },
                {
                  "type": "object",
                  "required": ["requiredOutputRefs"],
                  "properties": {
                    "requiredOutputRefs": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": { "type": "string", "pattern": "^OUT-[0-9]{3,}$" }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "protocolVersion": { "const": "4.0" } },
        "required": ["protocolVersion"]
      },
      "then": {
        "required": [
          "executionContractDigest",
          "promptSha256",
          "launchDigest",
          "checkpointReceipts",
          "partialAttainment",
          "sanitizationRequest",
          "v4Contract"
        ],
        "properties": {
          "taskPacket": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "digest", "bundleDigest"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "version": { "type": "string", "minLength": 1 },
              "digest": { "$ref": "artifact.schema.json#/$defs/sha256" },
              "bundleDigest": { "$ref": "artifact.schema.json#/$defs/sha256" }
            }
          },
          "checkpointReceipts": { "type": "array", "minItems": 1, "items": { "$ref": "stage-contract-v4.schema.json#/$defs/checkpointReceipt" } },
          "partialAttainment": true,
          "sanitizationRequest": true,
          "v4Contract": true
        }
      }
    }
  ]
}
