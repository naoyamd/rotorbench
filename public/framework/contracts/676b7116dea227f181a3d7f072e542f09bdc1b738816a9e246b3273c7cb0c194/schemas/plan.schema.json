{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotorbench.example/schemas/plan.schema.json",
  "title": "Candidate initial engineering plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "requirements",
    "assumptions",
    "steps",
    "alternativesToEvaluate",
    "verificationPlan"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "status": { "const": "initial" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" },
          "source": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "rationale", "risk"],
        "properties": {
          "id": { "type": "string", "pattern": "^ASM-[0-9]{3,}$" },
          "statement": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "risk": { "type": "string", "minLength": 1 }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "requirementRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^STEP-[0-9]{3,}$" },
          "statement": { "type": "string", "minLength": 1 },
          "requirementRefs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" }
          }
        }
      }
    },
    "alternativesToEvaluate": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "requirementRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^ALT-[0-9]{3,}$" },
          "question": { "type": "string", "minLength": 1 },
          "requirementRefs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" }
          }
        }
      }
    },
    "verificationPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirementRefs", "method", "expectedEvidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^VER-[0-9]{3,}$" },
          "requirementRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" }
          },
          "method": { "type": "string", "minLength": 1 },
          "expectedEvidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
