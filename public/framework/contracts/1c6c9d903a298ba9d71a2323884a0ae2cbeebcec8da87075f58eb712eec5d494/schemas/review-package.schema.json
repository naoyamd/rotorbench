{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotorbench.example/schemas/review-package.schema.json",
  "title": "Evaluator-owned identity-neutral review package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "reviewPackageId",
    "evidenceRoot",
    "scoringContract",
    "sanitizationReport",
    "evidence"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "const": "ready" },
    "reviewPackageId": { "type": "string", "pattern": "^review-[a-f0-9]{16}$" },
    "evidenceRoot": { "const": "evidence" },
    "scoringContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256", "outputPath", "outputSha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "artifact.schema.json#/$defs/sha256" },
        "outputPath": { "const": "scoring-contract.json" },
        "outputSha256": { "$ref": "artifact.schema.json#/$defs/sha256" }
      }
    },
    "sanitizationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "status"],
      "properties": {
        "sha256": { "$ref": "artifact.schema.json#/$defs/sha256" },
        "status": { "const": "passed" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "mediaType", "sha256", "bytes", "outputPath"],
        "properties": {
          "id": { "type": "string", "pattern": "^EVD-[0-9]{3,}$" },
          "kind": { "enum": ["initial-plan", "initial-plan-checkpoint", "work-record", "checkpoint-receipt", "artifact"] },
          "role": { "enum": ["cad-source", "step", "drawing", "bom", "calculation", "supporting"] },
          "mediaType": { "type": "string", "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$" },
          "sha256": { "$ref": "artifact.schema.json#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 0 },
          "outputPath": { "type": "string", "pattern": "^evidence/EVD-[0-9]{3,}\\.[A-Za-z0-9]+$" }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "artifact" } }, "required": ["kind"] },
            "then": { "required": ["role"], "properties": { "role": true } },
            "else": { "not": { "required": ["role"] } }
          }
        ]
      }
    }
  }
}
