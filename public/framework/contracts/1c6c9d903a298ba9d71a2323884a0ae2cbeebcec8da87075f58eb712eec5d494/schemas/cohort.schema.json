{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotorbench.example/schemas/cohort.schema.json",
  "title": "Engineering Design Benchmark Framework cohort",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "openedAt",
    "launchId",
    "fairnessFingerprint",
    "status",
    "candidateIds",
    "extensions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "openedAt": { "type": "string", "format": "date-time" },
    "launchId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "fairnessFingerprint": { "$ref": "artifact.schema.json#/$defs/sha256" },
    "status": { "type": "string", "enum": ["open", "published"] },
    "candidateIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "extensions": { "type": "object" }
  }
}
