{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotorbench.example/schemas/validation-report.schema.json",
  "title": "Engineering benchmark validation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "status", "generatedAt", "processor", "checks", "issues"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "runId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "type": "string", "enum": ["valid", "invalid", "warning", "processing"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "processor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "stepEngine"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "stepEngine": { "type": "string", "minLength": 1 },
        "isolation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["process", "timeoutMs", "maxOldSpaceMb", "networkIsolation"],
          "properties": {
            "process": { "type": "string", "minLength": 1 },
            "timeoutMs": { "type": "integer", "minimum": 1 },
            "maxOldSpaceMb": { "type": "integer", "minimum": 1 },
            "networkIsolation": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "warning"] },
          "detail": { "type": "string" },
          "artifactId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "inputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "derivedSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    }
  }
}
