  "document": "Fixed cell, fixture, workpiece, and grasp-region neutral geometry",
  "version": "1.0",
  "contractId": "robotic-handling-fixed-geometry-csg-v1",
  "units": "mm and degrees; all values are nominal benchmark geometry unless a tolerance is explicitly declared.",
  "purpose": "Provide the complete candidate-visible evaluator-relevant fixed geometry. This CSG-style neutral definition, not a candidate reconstruction from prose or bounding boxes, is authoritative for fixture insertion, interference, carried-part clearance, and primary grasp geometry.",
  "representation": {
    "coordinateFrame": "W from inputs/interface-dimensions.json",
    "primitiveVocabulary": {
      "box": "origin is the minimum XYZ corner; size is [x,y,z].",
      "cylinder": "axis is a unit vector; origin is the centre of the first circular face; length follows axis.",
      "extrusion": "profile is a closed XY polygon in the named local frame; length follows +Z of that frame."
    },
    "booleanVocabulary": "A solid is a union of additive primitives minus every subtractive primitive. Coincident boundaries belong to the fixed object.",
    "tolerancePolicy": "For collision and interface analysis use the geometry exactly as stated, then apply the object or interface tolerance where one is declared. Do not invent fillets, holes, pockets, wall thickness, or contact surfaces that are absent from this definition."
  },
  "graspSurfaceCoordinateContract": {
    "units": "mm",
    "appliesTo": "Every planar grasp surface having coordinateSystem. Cylindrical grasp regions retain their explicitly stated axis/radius/angle/z parameterization.",
    "pointFormula": "P(u,v) = origin + u*uAxis + v*vAxis, for uRange[0] <= u <= uRange[1] and vRange[0] <= v <= vRange[1]. The origin is the u=0, v=0 point, not the rectangle centre unless those coordinates state it.",
    "axisRule": "uAxis, vAxis, and normal are mutually orthogonal unit vectors. The signed axes, plane normal, and pointFormula are authoritative even where a paired opposed face intentionally reverses handedness; u and v are signed millimetres along their named axes.",
    "exposureRule": "solidFace identifies the additive box face on which every legal P(u,v) lies. normal points from material into free space. The source face and the complete bounded patch must be exposed after every listed boolean subtraction.",
    "verification": "Run inputs/grasp-surface-validator.mjs --geometry inputs/fixed-geometry.json. It deterministically checks the declared planar patches against their named CSG source faces, bounds, orientation, subtraction, and outside-free-space probes."
  },
