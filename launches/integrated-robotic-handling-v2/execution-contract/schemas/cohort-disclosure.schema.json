{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotorbench.example/schemas/cohort-disclosure.schema.json",
  "title": "Operator-owned post-review cohort model disclosure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cohortId",
    "launchId",
    "measurementConditionsSha256",
    "disclosedAt",
    "modelGroups"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "cohortId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "launchId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "measurementConditionsSha256": { "$ref": "artifact.schema.json#/$defs/sha256" },
    "disclosedAt": { "type": "string", "format": "date-time" },
    "modelGroups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/modelGroup" }
    }
  },
  "$defs": {
    "modelGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupId", "runIds", "model"],
      "properties": {
        "groupId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "runIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "name", "version", "reasoningSetting", "policy"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "reasoningSetting": { "type": "string", "minLength": 1 },
            "policy": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
