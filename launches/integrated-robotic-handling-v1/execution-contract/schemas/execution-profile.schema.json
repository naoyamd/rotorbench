{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotorbench.example/schemas/execution-profile.schema.json",
  "title": "Stage 0 common execution profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "canonicalBaseUrl",
    "outputRoot",
    "startAction",
    "stopConditions",
    "extensions"
  ],
  "properties": {
    "schemaVersion": { "enum": ["3.0", "4.0"] },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "minLength": 1 },
    "canonicalBaseUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#]+(?::[0-9]+)?(?:/[A-Za-z0-9._~-]+)*$"
    },
    "outputRoot": { "const": "candidate-output" },
    "startAction": { "const": "checkpoint-initial-plan" },
    "stopConditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "sanitization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxBundleFiles",
        "maxBundleBytes",
        "maxFileBytes",
        "maxPathLength",
        "maxJsonBytes",
        "maxTextBytes",
        "maxPdfBytes",
        "maxStepBytes",
        "maxImageBytes"
      ],
      "properties": {
        "maxBundleFiles": { "type": "integer", "minimum": 1 },
        "maxBundleBytes": { "type": "integer", "minimum": 1 },
        "maxFileBytes": { "type": "integer", "minimum": 1 },
        "maxPathLength": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "maxJsonBytes": { "type": "integer", "minimum": 1 },
        "maxTextBytes": { "type": "integer", "minimum": 1 },
        "maxPdfBytes": { "type": "integer", "minimum": 1 },
        "maxStepBytes": { "type": "integer", "minimum": 1 },
        "maxImageBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "extensions": { "type": "object" },
    "protocolVersion": { "enum": ["3.0", "4.0"] },
    "workspaceBootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "location", "sha256"],
      "properties": {
        "kind": { "enum": ["public-bundle", "public-repository-commit"] },
        "location": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "artifact.schema.json#/$defs/sha256" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": "4.0" } }, "required": ["schemaVersion"] },
      "then": {
        "required": ["protocolVersion", "workspaceBootstrap", "sanitization"],
        "properties": {
          "protocolVersion": { "const": "4.0" },
          "workspaceBootstrap": true,
          "sanitization": true
        }
      }
    }
  ]
}
