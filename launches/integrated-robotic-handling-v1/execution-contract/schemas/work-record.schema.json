{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotorbench.example/schemas/work-record.schema.json",
  "title": "Candidate engineering work record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "alternatives",
    "decisions",
    "planRevisions",
    "verificationClaims"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "disposition"],
        "properties": {
          "id": { "type": "string", "pattern": "^ALT-[0-9]{3,}$" },
          "description": { "type": "string", "minLength": 1 },
          "disposition": { "type": "string", "minLength": 1 }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirementRefs",
          "alternativeRefs",
          "choice",
          "rationale",
          "tradeoffs"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^DEC-[0-9]{3,}$" },
          "requirementRefs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" }
          },
          "alternativeRefs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^ALT-[0-9]{3,}$" }
          },
          "choice": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "tradeoffs": { "type": "string", "minLength": 1 }
        }
      }
    },
    "planRevisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason", "affectedStepRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^REV-[0-9]{3,}$" },
          "reason": { "type": "string", "minLength": 1 },
          "affectedStepRefs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^STEP-[0-9]{3,}$" }
          }
        }
      }
    },
    "verificationClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirementRefs",
          "method",
          "result",
          "evidenceArtifactRefs"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^CLAIM-[0-9]{3,}$" },
          "requirementRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" }
          },
          "method": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "fail", "not-run"] },
          "evidenceArtifactRefs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
          }
        }
      }
    }
  }
}
