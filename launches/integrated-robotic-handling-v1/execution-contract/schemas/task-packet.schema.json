{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotorbench.example/schemas/task-packet.schema.json",
  "title": "Engineering benchmark task packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "instructions",
    "inputs",
    "requiredOutputs",
    "environment",
    "completionCriteria"
  ],
  "properties": {
    "schemaVersion": { "enum": ["1.0", "3.0", "4.0"] },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "taskDefinitionDigest": { "$ref": "artifact.schema.json#/$defs/sha256" },
    "authorId": { "type": "string", "minLength": 1 },
    "instructions": { "$ref": "#/$defs/declaredFile" },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/input" }
    },
    "requiredOutputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/outputRole" },
          { "$ref": "#/$defs/requiredOutput" }
        ]
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "cad", "stepPipeline"],
      "properties": {
        "baseline": { "type": "string", "minLength": 1 },
        "cad": { "type": "string", "minLength": 1 },
        "stepPipeline": { "type": "string", "minLength": 1 }
      }
    },
    "completionCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "$ref": "#/$defs/completionCriterion" }
        ]
      }
    },
    "v4Contract": { "$ref": "stage-contract-v4.schema.json#/$defs/v4Contract" },
    "checkpoints": { "type": "array", "items": { "$ref": "stage-contract-v4.schema.json#/$defs/checkpoint" } },
    "changeEvents": { "type": "array", "items": { "$ref": "stage-contract-v4.schema.json#/$defs/changeEvent" } }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schemaVersion": { "const": "3.0" } },
        "required": ["schemaVersion"]
      },
      "then": {
        "required": ["taskDefinitionDigest", "authorId"],
        "properties": {
          "taskDefinitionDigest": true,
          "authorId": true,
          "instructions": { "$ref": "#/$defs/declaredFileV3" },
          "inputs": {
            "type": "array",
            "items": { "$ref": "#/$defs/inputV3" }
          },
          "requiredOutputs": {
            "type": "array",
            "items": { "$ref": "#/$defs/requiredOutput" }
          },
          "completionCriteria": {
            "type": "array",
            "items": { "$ref": "#/$defs/completionCriterion" }
          }
        }
      }
    },
    {
      "if": { "properties": { "schemaVersion": { "const": "4.0" } }, "required": ["schemaVersion"] },
      "then": {
        "required": ["taskDefinitionDigest", "authorId", "v4Contract", "checkpoints", "changeEvents"],
        "properties": {
          "instructions": { "$ref": "#/$defs/declaredFileV3" },
          "inputs": { "type": "array", "items": { "$ref": "#/$defs/inputV3" } },
          "requiredOutputs": { "type": "array", "items": { "$ref": "#/$defs/requiredOutput" } },
          "completionCriteria": { "type": "array", "items": { "$ref": "#/$defs/completionCriterion" } },
          "v4Contract": true,
          "checkpoints": { "type": "array", "minItems": 2, "items": { "$ref": "stage-contract-v4.schema.json#/$defs/checkpoint" } },
          "changeEvents": { "type": "array", "items": { "$ref": "stage-contract-v4.schema.json#/$defs/changeEvent" } }
        }
      }
    }
  ],
  "$defs": {
    "outputRole": {
      "enum": ["cad-source", "step", "drawing", "bom", "calculation", "supporting"]
    },
    "declaredFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "artifact.schema.json#/$defs/safePath" },
        "sha256": { "$ref": "artifact.schema.json#/$defs/sha256" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "mediaType": { "type": "string", "minLength": 1 },
        "downloadName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
      }
    },
    "declaredFileV3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sizeBytes", "mediaType", "downloadName"],
      "properties": {
        "path": { "$ref": "artifact.schema.json#/$defs/safePath" },
        "sha256": { "$ref": "artifact.schema.json#/$defs/sha256" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "mediaType": { "type": "string", "minLength": 1 },
        "downloadName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "path": { "$ref": "artifact.schema.json#/$defs/safePath" },
        "sha256": { "$ref": "artifact.schema.json#/$defs/sha256" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "mediaType": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "downloadName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
      }
    },
    "inputV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "sizeBytes",
        "mediaType",
        "provenance",
        "license",
        "downloadName"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "path": { "$ref": "artifact.schema.json#/$defs/safePath" },
        "sha256": { "$ref": "artifact.schema.json#/$defs/sha256" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "mediaType": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "downloadName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
      }
    },
    "requiredOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^OUT-[0-9]{3,}$" },
        "role": { "$ref": "#/$defs/outputRole" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "completionCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "requiredOutputRefs", "evidenceRoles"],
      "properties": {
        "id": { "type": "string", "pattern": "^CRIT-[0-9]{3,}$" },
        "statement": { "type": "string", "minLength": 1 },
        "requiredOutputRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^OUT-[0-9]{3,}$" }
        },
        "evidenceRoles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/outputRole" }
        }
      }
    }
  }
}
