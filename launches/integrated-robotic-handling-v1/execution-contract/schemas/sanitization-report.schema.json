{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotorbench.example/schemas/sanitization-report.schema.json",
  "title": "Evaluator-owned v4 candidate artifact sanitization report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "runId",
    "status",
    "outputRoot",
    "bundle",
    "launch",
    "packet",
    "executionProfile",
    "sanitizationProfile",
    "executionContract",
    "tool",
    "artifacts",
    "issues"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "runId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["passed", "failed"] },
    "outputRoot": { "$ref": "artifact.schema.json#/$defs/safePath" },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "submitted" },
        "sha256": { "$ref": "artifact.schema.json#/$defs/sha256" }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest", "fairnessFingerprint"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "digest": { "$ref": "artifact.schema.json#/$defs/sha256" },
        "fairnessFingerprint": { "$ref": "artifact.schema.json#/$defs/sha256" }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest", "bundleDigest"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "artifact.schema.json#/$defs/sha256" },
        "bundleDigest": { "$ref": "artifact.schema.json#/$defs/sha256" }
      }
    },
    "executionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest", "limits"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "artifact.schema.json#/$defs/sha256" },
        "limits": { "type": "object" }
      }
    },
    "sanitizationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "sha256"],
      "properties": {
        "digest": { "$ref": "artifact.schema.json#/$defs/sha256" },
        "sha256": { "$ref": "artifact.schema.json#/$defs/sha256" }
      }
    },
    "executionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "artifactContractSha256", "sanitizerSha256"],
      "properties": {
        "digest": { "$ref": "artifact.schema.json#/$defs/sha256" },
        "artifactContractSha256": { "$ref": "artifact.schema.json#/$defs/sha256" },
        "sanitizerSha256": { "$ref": "artifact.schema.json#/$defs/sha256" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sourceSha256"],
      "properties": {
        "name": { "const": "stage2-sanitize" },
        "version": { "type": "string", "minLength": 1 },
        "sourceSha256": { "$ref": "artifact.schema.json#/$defs/sha256" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "mediaType", "inputSha256", "outputPath", "outputSha256", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "path": { "$ref": "artifact.schema.json#/$defs/safePath" },
          "mediaType": { "type": "string", "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$" },
          "inputSha256": { "$ref": "artifact.schema.json#/$defs/sha256" },
          "outputPath": { "$ref": "artifact.schema.json#/$defs/safePath" },
          "outputSha256": { "$ref": "artifact.schema.json#/$defs/sha256" },
          "status": { "const": "admitted" }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "path": { "$ref": "artifact.schema.json#/$defs/safePath" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
      "then": { "properties": { "issues": { "type": "array", "maxItems": 0 } } }
    }
  ]
}
