{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotorbench.example/schemas/candidate-workspace-receipt.schema.json",
  "title": "Immutable candidate workspace materialization receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "createdAt",
    "source",
    "cleanRoot",
    "isolation",
    "materializedFiles"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "candidate-workspace-receipt" },
    "createdAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launchId",
        "canonicalBaseUrl",
        "launchDigest",
        "promptSha256",
        "executionContractDigest",
        "taskPacket",
        "workspaceBootstrap"
      ],
      "properties": {
        "launchId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "canonicalBaseUrl": { "type": "string", "format": "uri" },
        "launchDigest": { "$ref": "artifact.schema.json#/$defs/sha256" },
        "promptSha256": { "$ref": "artifact.schema.json#/$defs/sha256" },
        "executionContractDigest": { "$ref": "artifact.schema.json#/$defs/sha256" },
        "taskPacket": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "digest", "bundleDigest"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "version": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "artifact.schema.json#/$defs/sha256" },
            "bundleDigest": { "$ref": "artifact.schema.json#/$defs/sha256" }
          }
        },
        "workspaceBootstrap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "location", "sha256"],
          "properties": {
            "kind": { "const": "public-bundle" },
            "location": { "type": "string", "format": "uri" },
            "sha256": { "$ref": "artifact.schema.json#/$defs/sha256" }
          }
        }
      }
    },
    "cleanRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion",
        "targetExistedBeforeMaterialization",
        "atomicInstall",
        "symlinksRejected"
      ],
      "properties": {
        "assertion": { "const": "target-did-not-exist-before-atomic-materialization" },
        "targetExistedBeforeMaterialization": { "const": false },
        "atomicInstall": { "const": true },
        "symlinksRejected": { "const": true }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyPath",
        "policySha256",
        "enforcementAssurance",
        "enforcementStatement",
        "sourceAllowlist",
        "prohibitedSourcePrefixes"
      ],
      "properties": {
        "policyPath": { "const": "isolation-policy.json" },
        "policySha256": { "$ref": "artifact.schema.json#/$defs/sha256" },
        "enforcementAssurance": {
          "const": "operator-harness-attested-not-cryptographic-proof"
        },
        "enforcementStatement": { "type": "string", "minLength": 1 },
        "sourceAllowlist": {
          "type": "array",
          "minItems": 4,
          "items": { "type": "string", "minLength": 1 }
        },
        "prohibitedSourcePrefixes": {
          "type": "array",
          "minItems": 5,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "materializedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "sizeBytes", "source"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
          },
          "sha256": { "$ref": "artifact.schema.json#/$defs/sha256" },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path"],
            "properties": {
              "kind": {
                "enum": ["launch", "packet", "workspace-bootstrap", "execution-contract", "generated-policy"]
              },
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
              }
            }
          }
        }
      }
    }
  }
}
