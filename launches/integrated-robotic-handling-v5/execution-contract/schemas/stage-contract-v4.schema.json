{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotorbench.example/schemas/stage-contract-v4.schema.json",
  "title": "Stage 0/1/2 version 4 engineering benchmark contract components",
  "$defs": {
    "sha256": { "$ref": "artifact.schema.json#/$defs/sha256" },
    "safePath": { "$ref": "artifact.schema.json#/$defs/safePath" },
    "visibilityClass": {
      "enum": [
        "candidate-public",
        "run-private-instance",
        "evaluator-hidden-robustness",
        "event-private-change",
        "evaluator-secret"
      ]
    },
    "assetCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "visibilityClass", "disclosedAt", "requirementRefs", "digest"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$" },
        "visibilityClass": { "$ref": "#/$defs/visibilityClass" },
        "disclosedAt": {
          "enum": ["before-run", "run-start", "after-prior-receipt", "evaluator-only"]
        },
        "requirementRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" }
        },
        "digest": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "visibilityClass": { "const": "candidate-public" } }, "required": ["visibilityClass"] },
          "then": { "properties": { "disclosedAt": { "const": "before-run" } } }
        },
        {
          "if": { "properties": { "visibilityClass": { "const": "run-private-instance" } }, "required": ["visibilityClass"] },
          "then": { "properties": { "disclosedAt": { "const": "run-start" } } }
        },
        {
          "if": { "properties": { "visibilityClass": { "const": "event-private-change" } }, "required": ["visibilityClass"] },
          "then": { "properties": { "disclosedAt": { "const": "after-prior-receipt" } } }
        },
        {
          "if": { "properties": { "visibilityClass": { "enum": ["evaluator-hidden-robustness", "evaluator-secret"] } }, "required": ["visibilityClass"] },
          "then": { "properties": { "disclosedAt": { "const": "evaluator-only" } } }
        }
      ]
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "title", "phase", "requiredOutputRefs", "requiresPriorCheckpointIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^CKPT-[0-9]{3,}$" },
        "sequence": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 1 },
        "phase": { "enum": ["initial-plan", "concept", "embodiment", "verification", "submission", "change-response"] },
        "requiredForBaseline": {
          "type": "boolean",
          "description": "False only for an evaluator-issued optional panel checkpoint that is not required for a complete baseline submission."
        },
        "requiredOutputRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^OUT-[0-9]{3,}$" }
        },
        "requiresPriorCheckpointIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^CKPT-[0-9]{3,}$" }
        }
      }
    },
    "checkpointReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "checkpointId", "path", "sha256", "previousReceiptSha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^RCP-[0-9]{3,}$" },
        "sequence": { "type": "integer", "minimum": 0 },
        "checkpointId": { "type": "string", "pattern": "^CKPT-[0-9]{3,}$" },
        "path": { "$ref": "#/$defs/safePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "previousReceiptSha256": { "$ref": "#/$defs/sha256" },
        "changeEventId": { "type": "string", "pattern": "^CHG-[0-9]{3,}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "checkpointId": { "const": "CKPT-050" } }, "required": ["checkpointId"] },
          "then": {
            "properties": { "changeEventId": true },
            "required": ["changeEventId"]
          },
          "else": {
            "not": {
              "properties": { "changeEventId": true },
              "required": ["changeEventId"]
            }
          }
        }
      ]
    },
    "checkpointReceiptRecordV10": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "sequence", "checkpointId", "previousReceiptSha256", "createdAt", "evidence"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "id": { "type": "string", "pattern": "^RCP-[0-9]{3,}$" },
        "sequence": { "type": "integer", "minimum": 0 },
        "checkpointId": { "type": "string", "pattern": "^CKPT-[0-9]{3,}$" },
        "previousReceiptSha256": { "$ref": "#/$defs/sha256" },
        "createdAt": { "type": "string", "format": "date-time" },
        "changeEventId": { "type": "string", "pattern": "^CHG-[0-9]{3,}$" },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": { "path": { "$ref": "#/$defs/safePath" }, "sha256": { "$ref": "#/$defs/sha256" } }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "checkpointId": { "const": "CKPT-050" } }, "required": ["checkpointId"] },
          "then": {
            "properties": { "changeEventId": true },
            "required": ["changeEventId"]
          },
          "else": {
            "not": {
              "properties": { "changeEventId": true },
              "required": ["changeEventId"]
            }
          }
        }
      ]
    },
    "checkpointArtifactSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "snapshotPath", "sha256"],
      "properties": {
        "sourcePath": { "$ref": "#/$defs/safePath" },
        "snapshotPath": { "$ref": "#/$defs/safePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "checkpointOutputContractBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentVersion", "sha256", "requiredArtefactPaths"],
      "properties": {
        "componentVersion": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "requiredArtefactPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safePath" }
        }
      }
    },
    "checkpointReceiptRecordV11": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "sequence", "checkpointId", "previousReceiptSha256", "createdAt", "evidence", "artifactSnapshots"],
      "properties": {
        "schemaVersion": { "const": "1.1" },
        "id": { "type": "string", "pattern": "^RCP-[0-9]{3,}$" },
        "sequence": { "type": "integer", "minimum": 0 },
        "checkpointId": { "type": "string", "pattern": "^CKPT-[0-9]{3,}$" },
        "previousReceiptSha256": { "$ref": "#/$defs/sha256" },
        "createdAt": { "type": "string", "format": "date-time" },
        "changeEventId": { "type": "string", "pattern": "^CHG-[0-9]{3,}$" },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": { "path": { "$ref": "#/$defs/safePath" }, "sha256": { "$ref": "#/$defs/sha256" } }
          }
        },
        "outputContract": { "$ref": "#/$defs/checkpointOutputContractBinding" },
        "artifactSnapshots": {
          "type": "array",
          "items": { "$ref": "#/$defs/checkpointArtifactSnapshot" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "checkpointId": { "const": "CKPT-000" } }, "required": ["checkpointId"] },
          "then": {
            "not": {
              "properties": { "outputContract": true },
              "required": ["outputContract"]
            }
          },
          "else": {
            "properties": { "outputContract": true },
            "required": ["outputContract"]
          }
        },
        {
          "if": { "properties": { "checkpointId": { "const": "CKPT-050" } }, "required": ["checkpointId"] },
          "then": {
            "properties": { "changeEventId": true },
            "required": ["changeEventId"]
          },
          "else": {
            "not": {
              "properties": { "changeEventId": true },
              "required": ["changeEventId"]
            }
          }
        }
      ]
    },
    "checkpointReceiptRecord": {
      "oneOf": [
        { "$ref": "#/$defs/checkpointReceiptRecordV10" },
        { "$ref": "#/$defs/checkpointReceiptRecordV11" }
      ]
    },
    "changeEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "visibilityClass", "triggerAfterCheckpointId", "responseCheckpointId", "requirementRefs", "digest"],
      "properties": {
        "id": { "type": "string", "pattern": "^CHG-[0-9]{3,}$" },
        "visibilityClass": { "const": "event-private-change" },
        "triggerAfterCheckpointId": { "type": "string", "pattern": "^CKPT-[0-9]{3,}$" },
        "responseCheckpointId": { "type": "string", "pattern": "^CKPT-[0-9]{3,}$" },
        "requirementRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" }
        },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "v4Contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scoringVersion",
        "instanceBankManifest",
        "visibilityPolicy",
        "checkpointContract",
        "changeEventContract",
        "evaluationContract",
        "sanitizationProfile",
        "sealedAssetCommitments",
        "disclosureSchedule"
      ],
      "properties": {
        "scoringVersion": { "type": "string", "minLength": 1 },
        "instanceBankManifest": { "$ref": "#/$defs/assetCommitment" },
        "visibilityPolicy": { "$ref": "#/$defs/assetCommitment" },
        "checkpointContract": { "$ref": "#/$defs/assetCommitment" },
        "changeEventContract": { "$ref": "#/$defs/assetCommitment" },
        "evaluationContract": { "$ref": "#/$defs/assetCommitment" },
        "sanitizationProfile": { "$ref": "#/$defs/assetCommitment" },
        "sealedAssetCommitments": {
          "type": "array",
          "items": { "$ref": "#/$defs/assetCommitment" }
        },
        "disclosureSchedule": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assetCommitment" }
        }
      }
    },
    "partialAttainment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attemptedCheckpointIds", "completedCheckpointIds", "highestVerifiedCheckpointId", "stoppedReason"],
      "properties": {
        "attemptedCheckpointIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^CKPT-[0-9]{3,}$" } },
        "completedCheckpointIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^CKPT-[0-9]{3,}$" } },
        "highestVerifiedCheckpointId": { "type": "string", "pattern": "^CKPT-[0-9]{3,}$" },
        "stoppedReason": { "enum": ["completed", "time-limit", "tool-failure", "missing-declared-input", "candidate-stop", "other"] }
      }
    },
    "sanitizationAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "profileDigest", "status", "sanitizedArtifactIds"],
      "properties": {
        "actor": { "const": "evaluator" },
        "profileDigest": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["passed", "failed", "not-run"] },
        "sanitizedArtifactIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
        "report": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "$ref": "#/$defs/safePath" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["passed", "failed"] } }, "required": ["status"] },
          "then": { "properties": { "report": true }, "required": ["report"] }
        },
        {
          "if": { "properties": { "status": { "const": "not-run" } }, "required": ["status"] },
          "then": { "not": { "required": ["report"] } }
        }
      ]
    },
    "sanitizationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileDigest"],
      "properties": {
        "profileDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "reviewAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewPackage", "records"],
      "properties": {
        "reviewPackage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "path", "sha256"],
          "properties": {
            "id": { "type": "string", "pattern": "^review-[a-f0-9]{16}$" },
            "path": { "const": "sanitized/review-package/review-package.json" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "records": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "reviewerId", "role"],
            "properties": {
              "path": { "type": "string", "pattern": "^sanitized/reviews/rater-[a-f0-9]{16}\\.json$" },
              "sha256": { "$ref": "#/$defs/sha256" },
              "reviewerId": { "type": "string", "pattern": "^rater-[a-f0-9]{16}$" },
              "role": { "enum": ["primary", "secondary", "adjudicator"] }
            }
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": { "role": { "const": "primary" } },
                "required": ["role"]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": { "role": { "const": "secondary" } },
                "required": ["role"]
              }
            }
          ]
        }
      }
    },
    "evaluationRecord": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schemaVersion", "runId", "evaluationContractDigest", "scoringVersion", "status"],
      "properties": {
        "schemaVersion": { "const": "4.0" },
        "runId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "evaluationContractDigest": { "$ref": "#/$defs/sha256" },
        "scoringVersion": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pending", "admitted", "artifact-invalid", "evaluated", "evaluator-uncertain"] },
        "panel": {
          "enum": [
            "public-demonstration",
            "fixed-anchor-baseline",
            "hidden-robustness",
            "change-response",
            "fresh-generalization"
          ]
        },
        "qualification": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "admission": { "enum": ["pass", "fail", "not-run"] },
            "baseline": { "enum": ["pass", "fail", "not-run"] },
            "change": { "enum": ["pass", "fail", "not-run"] },
            "baselineQualified": { "type": ["boolean", "null"] },
            "changeQualified": { "type": ["boolean", "null"] },
            "changeFailureDoesNotEraseBaseline": { "type": "boolean" }
          }
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "attempted", "evaluable", "score"],
            "properties": {
              "id": { "type": "string", "pattern": "^D(?:0[1-9]|10)$" },
              "attempted": { "type": "boolean" },
              "evaluable": { "type": "boolean" },
              "score": { "type": ["number", "null"], "minimum": 0, "maximum": 4 },
              "scoreInterval": {
                "type": ["array", "null"],
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "number", "minimum": 0, "maximum": 4 }
              }
            }
          }
        },
        "attainment": {
          "type": "object",
          "additionalProperties": true
        },
        "reviewAudit": {
          "$ref": "#/$defs/reviewAudit"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "admitted" } }, "required": ["status"] },
          "then": {
            "properties": { "reviewAudit": true },
            "required": ["reviewAudit"]
          }
        }
      ]
    }
  }
}
