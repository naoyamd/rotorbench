{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotorbench.example/schemas/candidate-workspace-isolation-policy.schema.json",
  "title": "Candidate-visible workspace isolation policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "launchId",
    "allowedAccess",
    "accessPrecedence",
    "allowedRotorBenchUrls",
    "deniedRotorBenchPrefixes",
    "enforcementAssurance",
    "enforcementStatement"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "candidate-workspace-isolation-policy" },
    "launchId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "allowedAccess": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "accessPrecedence": {
      "const": "allow-exact-rotorbench-launch-url-over-denied-prefixes"
    },
    "allowedRotorBenchUrls": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uri" }
    },
    "deniedRotorBenchPrefixes": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "format": "uri" }
    },
    "enforcementAssurance": {
      "const": "operator-harness-attested-not-cryptographic-proof"
    },
    "enforcementStatement": { "type": "string", "minLength": 1 }
  }
}
