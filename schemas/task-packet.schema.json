{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotorbench.example/schemas/task-packet.schema.json",
  "title": "Engineering benchmark task packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "instructions",
    "inputs",
    "requiredOutputs",
    "environment",
    "completionCriteria"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "artifact.schema.json#/$defs/safePath" },
        "sha256": { "$ref": "artifact.schema.json#/$defs/sha256" }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 1 },
          "path": { "$ref": "artifact.schema.json#/$defs/safePath" },
          "sha256": { "$ref": "artifact.schema.json#/$defs/sha256" },
          "mediaType": { "type": "string", "minLength": 1 }
        }
      }
    },
    "requiredOutputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["cad-source", "step", "drawing", "bom", "calculation", "supporting"]
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "cad", "stepPipeline"],
      "properties": {
        "baseline": { "type": "string", "minLength": 1 },
        "cad": { "type": "string", "minLength": 1 },
        "stepPipeline": { "type": "string", "minLength": 1 }
      }
    },
    "completionCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
