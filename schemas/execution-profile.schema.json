{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotorbench.example/schemas/execution-profile.schema.json",
  "title": "Stage 0 common execution profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "canonicalBaseUrl",
    "outputRoot",
    "startAction",
    "stopConditions",
    "extensions"
  ],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "minLength": 1 },
    "canonicalBaseUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#]+(?::[0-9]+)?(?:/[A-Za-z0-9._~-]+)*$"
    },
    "outputRoot": { "const": "candidate-output" },
    "startAction": { "const": "checkpoint-initial-plan" },
    "stopConditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "extensions": { "type": "object" }
  }
}
