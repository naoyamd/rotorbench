{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotorbench.example/schemas/stage0-task-definition.schema.json",
  "title": "Stage 0 engineering task definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "author",
    "instructions",
    "inputs",
    "requiredOutputs",
    "completionCriteria",
    "environment",
    "engineeringValues",
    "extensions"
  ],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mediaType", "downloadName"],
      "properties": {
        "path": { "$ref": "artifact.schema.json#/$defs/safePath" },
        "mediaType": { "const": "text/markdown" },
        "downloadName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
      }
    },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/input" }
    },
    "requiredOutputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requiredOutput" }
    },
    "completionCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/completionCriterion" }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "cad", "stepPipeline"],
      "properties": {
        "baseline": { "type": "string", "minLength": 1 },
        "cad": { "type": "string", "minLength": 1 },
        "stepPipeline": { "type": "string", "minLength": 1 }
      }
    },
    "engineeringValues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "value", "unit", "source", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^VAL-[0-9]{3,}$" },
          "name": { "type": "string", "minLength": 1 },
          "value": {},
          "unit": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "reference"],
            "properties": {
              "kind": {
                "enum": ["declared-input", "cited-standard", "calculation", "author-assumption"]
              },
              "reference": { "type": "string", "minLength": 1 }
            }
          },
          "status": { "enum": ["resolved", "unresolved"] }
        }
      }
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "mediaType",
        "provenance",
        "license",
        "downloadName"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "path": { "$ref": "artifact.schema.json#/$defs/safePath" },
        "mediaType": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "downloadName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
      }
    },
    "requiredOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^OUT-[0-9]{3,}$" },
        "role": {
          "enum": ["cad-source", "step", "drawing", "bom", "calculation", "supporting"]
        },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "completionCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "requiredOutputRefs", "evidenceRoles"],
      "properties": {
        "id": { "type": "string", "pattern": "^CRIT-[0-9]{3,}$" },
        "statement": { "type": "string", "minLength": 1 },
        "requiredOutputRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^OUT-[0-9]{3,}$" }
        },
        "evidenceRoles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["cad-source", "step", "drawing", "bom", "calculation", "supporting"]
          }
        }
      }
    }
  }
}
