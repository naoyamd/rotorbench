{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotorbench.example/schemas/launch.schema.json",
  "title": "Engineering benchmark Stage 1 launcher",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "protocolVersion",
    "taskPacket",
    "baselineCommit",
    "workspaceDigest",
    "outputRoot",
    "startAction",
    "stopConditions",
    "fairnessFingerprint"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "protocolVersion": { "const": "2.0" },
    "taskPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "artifact.schema.json#/$defs/sha256" }
      }
    },
    "baselineCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "workspaceDigest": { "$ref": "artifact.schema.json#/$defs/sha256" },
    "outputRoot": { "const": "candidate-output" },
    "startAction": { "const": "checkpoint-initial-plan" },
    "stopConditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "fairnessFingerprint": { "$ref": "artifact.schema.json#/$defs/sha256" }
  }
}
