{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotorbench.example/schemas/measurement-conditions.schema.json",
  "title": "Engineering benchmark cohort measurement conditions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "frozenAt",
    "launchId",
    "launchDigest",
    "fairnessFingerprint",
    "executionProfileDigest",
    "candidateRunIds",
    "modelGroups",
    "runConditions",
    "repetitionPolicy"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "frozenAt": { "type": "string", "format": "date-time" },
    "launchId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "launchDigest": { "$ref": "artifact.schema.json#/$defs/sha256" },
    "fairnessFingerprint": { "$ref": "artifact.schema.json#/$defs/sha256" },
    "executionProfileDigest": { "$ref": "artifact.schema.json#/$defs/sha256" },
    "candidateRunIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "modelGroups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["groupId", "runIds"],
        "properties": {
          "groupId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "runIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        }
      }
    },
    "runConditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsedTimeLimitMinutes",
        "tokenBudget",
        "reasoningPreset",
        "toolAccessProfile",
        "networkPolicy",
        "randomnessPolicy",
        "humanInterventionLimit"
      ],
      "properties": {
        "elapsedTimeLimitMinutes": { "type": "integer", "minimum": 1 },
        "tokenBudget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["exact-limit", "provider-metered-unbounded"] },
            "maximumTokens": { "type": "integer", "minimum": 1 }
          },
          "allOf": [
            {
              "if": {
                "properties": { "mode": { "const": "exact-limit" } },
                "required": ["mode"]
              },
              "then": {
                "properties": { "maximumTokens": true },
                "required": ["maximumTokens"]
              },
              "else": {
                "properties": { "maximumTokens": true },
                "not": { "required": ["maximumTokens"] }
              }
            }
          ]
        },
        "reasoningPreset": { "type": "string", "minLength": 1 },
        "toolAccessProfile": { "type": "string", "minLength": 1 },
        "networkPolicy": {
          "enum": [
            "public-research-allowed",
            "declared-inputs-only",
            "network-disabled"
          ]
        },
        "randomnessPolicy": {
          "enum": [
            "fixed-seed-and-recorded",
            "provider-default-recorded"
          ]
        },
        "humanInterventionLimit": { "const": 0 }
      }
    },
    "repetitionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runsPerModel", "assignmentRecordedOutsideCandidate"],
      "properties": {
        "runsPerModel": { "type": "integer", "minimum": 1, "maximum": 10 },
        "assignmentRecordedOutsideCandidate": { "const": true }
      }
    },
    "notes": { "type": "string" }
  }
}
