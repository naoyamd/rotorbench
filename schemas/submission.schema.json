{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotorbench.example/schemas/submission.schema.json",
  "title": "Candidate engineering submission bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolVersion",
    "status",
    "launchId",
    "taskPacket",
    "fairnessFingerprint",
    "model",
    "initialPlan",
    "initialPlanCheckpoint",
    "workRecord",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "protocolVersion": { "const": "2.0" },
    "status": { "const": "complete" },
    "launchId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "taskPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "artifact.schema.json#/$defs/sha256" }
      }
    },
    "fairnessFingerprint": { "$ref": "artifact.schema.json#/$defs/sha256" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "version"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "initialPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "plan.json" },
        "sha256": { "$ref": "artifact.schema.json#/$defs/sha256" }
      }
    },
    "initialPlanCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "initial-plan.sha256" },
        "sha256": { "$ref": "artifact.schema.json#/$defs/sha256" }
      }
    },
    "workRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "work-record.json" },
        "sha256": { "$ref": "artifact.schema.json#/$defs/sha256" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "artifact.schema.json" }
    }
  }
}
