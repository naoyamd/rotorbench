{
  "document": "Candidate engineering evidence and checkpoint contract",
  "version": "1.0",
  "outputRoot": "candidate-output",
  "purpose": "Define the minimum inspectable artefacts and checkpoint evidence for a complete Stage 1 engineering submission.",
  "protocolCheckpoint": {
    "id": "CKPT-000",
    "path": "candidate-output/plan.json",
    "companionDigestPath": "candidate-output/initial-plan.sha256",
    "rule": "Write before creating or modifying engineering design artefacts. The execution protocol seals both files and subsequent changes invalidate the checkpoint."
  },
  "candidateCheckpoints": [
    {
      "id": "CKPT-010",
      "name": "architecture-and-interface-freeze",
      "requiredArtefacts": ["design/requirements-trace.csv", "design/concept-selection.md", "motion/kinematics.json", "gripper/gripper-design.json"],
      "purpose": "Record architecture selection, interfaces, kinematics, and gripper mechanism before detailed release evidence."
    },
    {
      "id": "CKPT-020",
      "name": "embodiment-and-neutral-model-freeze",
      "requiredArtefacts": ["cad/source-manifest.json", "cad/assembly.step", "motion/kinematics.json", "bom/bom.csv"],
      "purpose": "Record the embodiment, neutral geometry, kinematic handoff, and structured bill of materials before detailed verification evidence."
    },
    {
      "id": "CKPT-030",
      "name": "critical-design-evidence-complete",
      "requiredArtefacts": ["bom/bom.csv", "calculations/system-calculations.pdf", "drawings/critical-drawing-index.csv", "safety/risk-fmea.csv"],
      "purpose": "Record critical calculation, drawing, manufacturing, and safety evidence before final packaging."
    },
    {
      "id": "CKPT-040",
      "name": "submission-release",
      "requiredArtefacts": ["cad/assembly.step", "evidence/verification-report.md", "evidence/evidence-manifest.json", "design/change-readiness.csv"],
      "purpose": "Bind neutral handoff and final evidence to the sealed baseline submission."
    },
    {
      "id": "CKPT-050",
      "name": "change-response-release",
      "requiredArtefacts": ["design/change-readiness.csv", "motion/kinematics.json", "calculations/calculation-register.csv", "gripper/gripper-design.json", "evidence/verification-report.md"],
      "purpose": "After the event-private change is disclosed, bind the affected design decisions, calculations, gripper package, motion evidence, and verification response."
    }
  ],
  "artefacts": [
    {
      "id": "ART-001",
      "path": "design/requirements-trace.csv",
      "role": "supporting",
      "requiredOutputRef": "OUT-003",
      "mediaType": "text/csv",
      "requiredFields": ["requirementId", "designDecision", "verificationMethod", "evidencePath", "acceptanceMeasure", "result", "uncertainty", "status"]
    },
    {
      "id": "ART-002",
      "path": "design/concept-selection.md",
      "role": "supporting",
      "requiredOutputRef": "OUT-003",
      "mediaType": "text/markdown",
      "requiredFields": ["three-or-more architectures", "selection rationale", "rejection rationale", "unresolved risks"]
    },
    {
      "id": "ART-003",
      "path": "cad/source-manifest.json",
      "role": "cad-source",
      "requiredOutputRef": "OUT-001",
      "mediaType": "application/json",
      "requiredFields": ["sourceFiles", "toolchain", "reproducibilityInstructions", "assemblyRoot", "externalReferencePolicy"]
    },
    {
      "id": "ART-004",
      "path": "cad/assembly.step",
      "role": "step",
      "requiredOutputRef": "OUT-002",
      "mediaType": "model/step",
      "requiredFields": ["complete assembly", "base-to-fingertips", "purchased components", "gripper mechanism", "workpiece interface references"]
    },
    {
      "id": "ART-005",
      "path": "motion/kinematics.json",
      "role": "supporting",
      "requiredOutputRef": "OUT-003",
      "mediaType": "application/json",
      "requiredFields": ["coordinateFrames", "jointTopology", "jointLimits", "jointTransforms", "tcpTransform", "payloadStates", "requiredPoses", "carriedEnvelopeRefs", "collisionGeometryRefs"]
    },
    {
      "id": "ART-006",
      "path": "bom/bom.csv",
      "role": "bom",
      "requiredOutputRef": "OUT-004",
      "mediaType": "text/csv",
      "requiredFields": ["partNumber", "description", "quantity", "makeBuy", "materialOrCatalogId", "mass", "process", "costBasis", "source", "uncertainty"]
    },
    {
      "id": "ART-007",
      "path": "calculations/system-calculations.pdf",
      "role": "calculation",
      "requiredOutputRef": "OUT-005",
      "mediaType": "application/pdf",
      "requiredFields": ["workspace", "cycle", "load-cases", "drive-sizing", "brake-sizing", "gripper-force", "contact-retention", "structure-deflection", "life", "accuracy-budget", "energy"]
    },
    {
      "id": "ART-008",
      "path": "calculations/calculation-register.csv",
      "role": "calculation",
      "requiredOutputRef": "OUT-005",
      "mediaType": "text/csv",
      "requiredFields": ["claim", "inputSources", "method", "modelScope", "result", "units", "acceptanceMeasure", "uncertainty", "evidencePath"]
    },
    {
      "id": "ART-009",
      "path": "drawings/critical-drawing-index.csv",
      "role": "drawing",
      "requiredOutputRef": "OUT-006",
      "mediaType": "text/csv",
      "requiredFields": ["drawingId", "partOrAssembly", "criticalFunction", "datumScheme", "toleranceStrategy", "material", "process", "inspectionMethod", "drawingPath"]
    },
    {
      "id": "ART-010",
      "path": "gripper/gripper-design.json",
      "role": "supporting",
      "requiredOutputRef": "OUT-007",
      "mediaType": "application/json",
      "requiredFields": ["actuation", "openingRange", "forceDisplacement", "transmission", "fingerGeometry", "contactSurfaces", "workpieceConfigurations", "presenceSensingInterface", "lossOfPowerBehavior", "primaryRetentionPath"]
    },
    {
      "id": "ART-011",
      "path": "safety/risk-fmea.csv",
      "role": "supporting",
      "requiredOutputRef": "OUT-008",
      "mediaType": "text/csv",
      "requiredFields": ["requirementId", "hazardOrFailureMode", "cause", "effect", "control", "verification", "residualRisk", "owner", "uncertainty"]
    },
    {
      "id": "ART-012",
      "path": "safety/service-and-utility-plan.md",
      "role": "supporting",
      "requiredOutputRef": "OUT-008",
      "mediaType": "text/markdown",
      "requiredFields": ["brakes", "stops", "retention", "pinchZones", "residualEnergy", "serviceAccess", "cableUtilityRouting"]
    },
    {
      "id": "ART-013",
      "path": "evidence/verification-report.md",
      "role": "supporting",
      "requiredOutputRef": "OUT-009",
      "mediaType": "text/markdown",
      "requiredFields": ["qualificationGates", "requirementResults", "limitations", "unsupportedClasses", "selfCheckResults"]
    },
    {
      "id": "ART-014",
      "path": "evidence/evidence-manifest.json",
      "role": "supporting",
      "requiredOutputRef": "OUT-009",
      "mediaType": "application/json",
      "requiredFields": ["artifactPaths", "sha256", "requirementRefs", "evidenceRoles", "provenance", "uncertainty", "status"]
    },
    {
      "id": "ART-015",
      "path": "design/change-readiness.csv",
      "role": "supporting",
      "requiredOutputRef": "OUT-009",
      "mediaType": "text/csv",
      "requiredFields": ["changeCategory", "affectedInterfaces", "affectedParts", "affectedCalculations", "affectedEvidence", "revalidationPlan"]
    }
  ],
  "neutralHandoff": {
    "step": "ISO 10303 STEP AP242 where candidate CAD supports it; export limitations and retained identifiers must be declared.",
    "kinematics": "JSON representation to be frozen by the Stage 1 v4 schema. It is the authoritative motion/evaluation handoff, not a candidate executable.",
    "pmi": "Critical PMI may be supplied through supported STEP AP242 PMI and/or controlled drawings. The evidence manifest shall state which channel is authoritative for each feature.",
    "staticOnly": "The evaluator accepts static data, drawings, reports, and archives. It does not execute candidate macros, scripts, binaries, web pages, or CAD embedded code."
  },
  "candidateOutputBoundary": {
    "permitted": ["CAD source", "STEP", "JSON", "CSV", "PDF", "plain text", "static images used as supporting evidence"],
    "prohibited": ["executables", "macros", "embedded CAD scripts", "external links required for evidence", "credentials", "network-dependent artefacts", "candidate web applications"],
    "sanitization": "A frozen launch supplies the exact sanitizer and file-type rules. Non-conforming artefacts are classified artifact-invalid rather than opened unsafely."
  },
  "status": "public-v1.0; file hashes and execution-specific archive limits are bound by the frozen launch contract."
}
