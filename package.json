{
  "name": "rotorbench",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "catalog": "node scripts/build-result-catalog.mjs",
    "framework:validate": "node scripts/framework-validate.mjs",
    "framework:process-step": "node scripts/process-step.mjs",
    "framework:index": "node scripts/build-framework-catalog.mjs",
    "framework:verify-links": "node scripts/verify-static-links.mjs",
    "framework:verify-base-path": "node scripts/verify-base-path-build.mjs",
    "framework:clean-placeholders": "node scripts/clean-framework-placeholders.mjs",
    "stage1:validate": "node scripts/stage1-validate.mjs",
    "stage1:checkpoint": "node scripts/stage1-checkpoint.mjs",
    "stage2:integrate": "node scripts/stage2-integrate.mjs",
    "stage2:publish-cohort": "node scripts/stage2-publish-cohort.mjs",
    "packet:finalize": "node scripts/finalize-task-packet.mjs",
    "launch:finalize": "node scripts/finalize-launch.mjs",
    "framework:prepare": "pnpm framework:validate && pnpm framework:process-step && pnpm framework:index",
    "predev": "pnpm catalog && pnpm framework:prepare",
    "dev": "vinext dev",
    "prebuild": "pnpm catalog && pnpm framework:prepare",
    "build": "vinext build",
    "postbuild": "pnpm framework:clean-placeholders",
    "check:sites": "pnpm prebuild && node scripts/build-sites-root.mjs && pnpm postbuild && node scripts/verify-sites-build.mjs",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "test": "pnpm framework:prepare && pnpm catalog && next build && pnpm framework:clean-placeholders && pnpm framework:verify-links && node --test tests/*.test.mjs",
    "check": "pnpm framework:prepare && pnpm catalog && tsc --noEmit && eslint . --ignore-pattern dist --ignore-pattern .next && next build && pnpm framework:clean-placeholders && pnpm framework:verify-links && node --test tests/*.test.mjs && pnpm framework:verify-base-path && pnpm check:sites",
    "export:pages": "pnpm build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "clean": "node -e \"const fs=require('node:fs'); for(const p of ['.next','out','dist']) fs.rmSync(p,{recursive:true,force:true})\""
  },
  "dependencies": {
    "next": "16.2.6",
    "occt-import-js": "^0.0.23",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
