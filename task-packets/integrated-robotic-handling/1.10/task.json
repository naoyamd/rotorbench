  "requiredOutputs": [
    {
      "id": "OUT-001",
      "role": "cad-source",
      "description": "Native or reproducible parametric CAD source for the complete integrated system, with an assembly manifest."
    },
    {
      "id": "OUT-002",
      "role": "step",
      "description": "Neutral STEP AP242 assembly export containing the complete candidate-designed mechanical system and declared purchased components."
    },
    {
      "id": "OUT-003",
      "role": "supporting",
      "description": "Neutral kinematic and motion manifest, required-pose evidence, requirement trace, and concept-selection record."
    },
    {
      "id": "OUT-004",
      "role": "bom",
      "description": "Complete structured BOM with provenance, quantities, mass, material/process, and cost basis or uncertainty."
    },
    {
      "id": "OUT-005",
      "role": "calculation",
      "description": "System calculation package covering motion, loads, drives, gripper retention, structure, life, accuracy, and energy."
    },
    {
      "id": "OUT-006",
      "role": "drawing",
      "description": "Controlled critical-part and gripper drawings/PMI with datum, tolerance, material, and inspection information."
    },
    {
      "id": "OUT-007",
      "role": "supporting",
      "description": "Full powered-gripper mechanism and all-workpiece grasp package, including force/displacement, contacts, sensing, retention, and fault behavior."
    },
    {
      "id": "OUT-008",
      "role": "supporting",
      "description": "Mechanical safety, reliability, risk/FMEA, service, and utility-routing package."
    },
    {
      "id": "OUT-009",
      "role": "supporting",
      "description": "Requirement-linked verification report, evidence manifest, uncertainty register, and change-readiness record."
    }
  ],
  "completionCriteria": [
    {
      "id": "CRIT-001",
      "statement": "Every applicable public requirement is mapped to a completed design decision, verification method, evidence artefact, acceptance measure, result, and known uncertainty.",
      "requiredOutputRefs": ["OUT-003", "OUT-005", "OUT-009"],
      "evidenceRoles": ["supporting", "calculation"]
    },
    {
      "id": "CRIT-002",
      "statement": "The finished design treats the base, manipulator, wrist, powered gripper, and workpiece contact load path as one integrated system, and its complete geometry can be independently imported through the neutral handoff.",
      "requiredOutputRefs": ["OUT-001", "OUT-002", "OUT-003", "OUT-007"],
      "evidenceRoles": ["cad-source", "step", "supporting"]
    },
    {
      "id": "CRIT-003",
      "statement": "The complete submission provides inspectable CAD, STEP, drawing, BOM, calculation, motion, gripper, safety, verification, and change-readiness evidence, all traceable to the immutable protocol-owned initial-plan checkpoint.",
      "requiredOutputRefs": ["OUT-001", "OUT-002", "OUT-004", "OUT-005", "OUT-006", "OUT-008", "OUT-009"],
      "evidenceRoles": ["cad-source", "step", "drawing", "bom", "calculation", "supporting"]
    }
  ],
